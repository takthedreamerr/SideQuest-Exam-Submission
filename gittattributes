
# Automatically normalise line endings
* text=auto

# Web development files
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.json text eol=lf
*.md text eol=lf
*.txt text eol=lf

# Configuration files
*.env text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.xml text eol=lf

# Images and other binary assets
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.svg text eol=lf

# Video and audio assets
*.mp4 binary
*.mov binary
*.webm binary
*.mp3 binary
*.wav binary
*.ogg binary

# Fonts
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary

# PDF documents
*.pdf binary
